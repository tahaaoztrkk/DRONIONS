<?xml version="1.0"?>
<model>
  <name>dronions_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    PX4's mono_cam with the lens under this project's control. Forked because
    horizontal_fov is an experimental variable here, not a fixed property, and
    editing PX4's stock model would silently change every other airframe that
    includes it.
  </description>
</model>
